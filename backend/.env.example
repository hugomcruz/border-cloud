# Backend environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Hetzner Cloud API token (from https://console.hetzner.cloud/)
HETZNER_API_TOKEN=your_hetzner_api_token_here

# Cloudflare API token (needs Zone:Read + DNS:Edit permissions)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# PostgreSQL connection URLs
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hetzner_vm_ui
DATABASE_URL_TEST=postgresql+asyncpg://postgres:postgres@localhost:5432/hetzner_vm_ui_test

# JWT configuration
SECRET_KEY=change_me_to_a_random_256_bit_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Public IP reflection service URL (used when X-Forwarded-For not present)
IP_REFLECTION_URL=https://api.ipify.org?format=json

# Admin user password (used by seed.py to create the initial admin account)
ADMIN_PASSWORD=change_me_to_a_strong_password
