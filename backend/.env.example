# Backend environment variables (local development without Docker)
# When running with Docker Compose, use the root .env.example instead.
# Copy this file to backend/.env and fill in your values only if running
# the backend directly (e.g. uvicorn outside of Docker).
# NEVER commit .env to version control.

# Hetzner Cloud API token (from https://console.hetzner.cloud/)
HETZNER_API_TOKEN=your_hetzner_api_token_here

# Cloudflare API token (needs Zone:Read + DNS:Edit permissions)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# PostgreSQL connection URL (use localhost when running outside Docker)
DATABASE_URL=postgresql+asyncpg://vmapp:change_me@localhost:5432/vmapp

# JWT configuration
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_random_64_char_hex_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Public IP reflection service URL
IP_REFLECTION_URL=https://api.ipify.org?format=json

# Admin user password (used by seed.py to create the initial admin account)
ADMIN_PASSWORD=change_me_to_a_strong_password

# Set to False when running over plain HTTP
SECURE_COOKIES=false

# Set to true to enable /docs and /openapi.json
DEBUG=false
