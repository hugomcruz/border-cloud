# ============================================================
# Border Cloud — environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Deployment ───────────────────────────────────────────────
# Image tag to deploy (e.g. "latest" or "build-42")
IMAGE_TAG=latest

# ── Database ─────────────────────────────────────────────────
# Production: point to your external/managed PostgreSQL instance.
DATABASE_URL=postgresql+asyncpg://user:password@your-db-host:5432/vmapp

# Dev compose only (docker-compose.yml spins up a local Postgres service).
# These are ignored by docker-compose.prod.yml.
POSTGRES_USER=vmapp
POSTGRES_PASSWORD=change_me_to_a_strong_db_password
POSTGRES_DB=vmapp

# ── Frontend ─────────────────────────────────────────────────
# Public URL of the frontend (used by NextAuth redirects)
NEXTAUTH_URL=https://your-domain.com

# ── JWT ──────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_random_64_char_hex_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Hetzner Cloud ────────────────────────────────────────────
HETZNER_API_TOKEN=your_hetzner_api_token_here
HETZNER_FIREWALL_NAME=

# ── Cloudflare ───────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ZONE_NAME=

# ── App settings ─────────────────────────────────────────────
SECURE_COOKIES=true
LOG_LEVEL=info
# Set to true to enable /docs and /openapi.json (disable in production)
DEBUG=false
LOGIN_RATE_LIMIT=10/minute
IP_REFLECTION_URL=https://api.ipify.org?format=json

# ── Admin bootstrap ──────────────────────────────────────────
# Used only by scripts/seed.py to create the initial admin account
ADMIN_PASSWORD=change_me_to_a_strong_admin_password
