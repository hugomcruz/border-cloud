# Frontend environment variables
# Copy this file to .env.local and adjust as needed.
# NEVER commit .env.local to version control.

# URL of the FastAPI backend — used by Next.js rewrites to proxy /api/* calls.
# In Docker Compose, use the service name: http://backend:8000
# Locally (running without Docker): http://localhost:8000
API_URL=http://localhost:8000
