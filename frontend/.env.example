# Frontend environment variables
# Copy this file to .env.local and adjust as needed.
# NEVER commit .env.local to version control.

# URL of the FastAPI backend — used by Next.js rewrites to proxy /api/* calls.
# In Docker Compose, use the service name: http://backend:8000
# Locally (running without Docker): http://localhost:8000
API_URL=http://localhost:8000

# UI theme: "dark" (default) or "light"
# Read at runtime by the Next.js server — no rebuild required to change.
# THEME=dark

# Custom logo URL — must be publicly accessible or a path under /public.
# Read at runtime — no rebuild required to change.
# LOGO_URL=

# Idle timeout in minutes before auto-logout (default: 30).
# Must be <= ACCESS_TOKEN_EXPIRE_MINUTES set on the backend.
# NEXT_PUBLIC_SESSION_TIMEOUT_MINUTES=30
